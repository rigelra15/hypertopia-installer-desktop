# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control — it is listed in .gitignore.

# Google OAuth credentials (from Google Cloud Console)
REACT_APP_GOOGLE_API_KEY="your-google-api-key-here"
REACT_APP_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# HyperTopia API secret (used for app attestation / X-API-Secret header)
REACT_APP_HYPERTOPIA_API_SECRET=your-api-secret-here

# ZIP archive password (used to extract password-protected game archives)
REACT_APP_ZIP_PASSWORD=your-zip-password-here
